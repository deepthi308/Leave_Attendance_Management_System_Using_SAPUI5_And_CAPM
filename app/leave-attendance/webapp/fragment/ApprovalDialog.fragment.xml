<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="approveDialog"
        title="Approve Leave Request"
        contentWidth="32rem"
    >
        <content>
            <VBox
                width="100%"
                class="sapUiMediumMargin"
            >
                <Text
                    text="Are you sure you want to approve this leave request?"
                    wrapping="true"
                    class="sapUiSmallMarginBottom"
                />

                <Label
                    text="Manager Comments"
                    labelFor="approveManagerCommentsInput"
                />

                <TextArea
                    id="approveManagerCommentsInput"
                    width="100%"
                    rows="5"
                    maxLength="1000"
                    placeholder="Enter comments (optional)"
                />
            </VBox>
        </content>

        <beginButton>
            <Button
                id="approveDialogConfirmButton"
                text="Approve"
                type="Emphasized"
                icon="sap-icon://accept"
                press=".onConfirmApprove"
            />
        </beginButton>

        <endButton>
            <Button
                id="approveDialogCancelButton"
                text="Cancel"
                press=".onCancelApprove"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>