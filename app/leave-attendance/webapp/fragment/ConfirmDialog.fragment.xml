<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="confirmDialog"
        title="Confirm Action"
        contentWidth="28rem"
    >
        <content>
            <VBox
                width="100%"
                class="sapUiMediumMargin"
            >
                <HBox
                    alignItems="Center"
                    class="sapUiSmallMarginBottom"
                >
                    <Text
                        id="confirmDialogMessage"
                        text="Are you sure you want to continue?"
                        wrapping="true"
                    />
                </HBox>
            </VBox>
        </content>

        <beginButton>
            <Button
                id="confirmDialogYesButton"
                text="Confirm"
                type="Emphasized"
                icon="sap-icon://accept"
                press=".onConfirmAction"
            />
        </beginButton>

        <endButton>
            <Button
                id="confirmDialogNoButton"
                text="Cancel"
                press=".onCancelConfirm"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>