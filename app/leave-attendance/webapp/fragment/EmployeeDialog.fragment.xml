<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="employeeDialog"
        title="Employee Details"
        contentWidth="40rem"
    >
        <content>
            <VBox
                width="100%"
                class="sapUiMediumMargin"
            >
                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="48%">
                        <Label
                            text="Employee ID"
                            labelFor="employeeIdInput"
                        />
                        <Input
                            id="employeeIdInput"
                            width="100%"
                            placeholder="Enter Employee ID"
                            maxLength="20"
                        />
                    </VBox>

                    <VBox width="48%">
                        <Label
                            text="Status"
                            labelFor="employeeStatusSelect"
                        />
                        <Select
                            id="employeeStatusSelect"
                            width="100%"
                            selectedKey="ACTIVE"
                        >
                            <items>
                                <core:Item
                                    key="ACTIVE"
                                    text="Active"
                                />
                                <core:Item
                                    key="INACTIVE"
                                    text="Inactive"
                                />
                            </items>
                        </Select>
                    </VBox>
                </HBox>

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                    class="sapUiSmallMarginTop"
                >
                    <VBox width="48%">
                        <Label
                            text="First Name"
                            labelFor="employeeFirstNameInput"
                        />
                        <Input
                            id="employeeFirstNameInput"
                            width="100%"
                            placeholder="Enter first name"
                            maxLength="50"
                        />
                    </VBox>

                    <VBox width="48%">
                        <Label
                            text="Last Name"
                            labelFor="employeeLastNameInput"
                        />
                        <Input
                            id="employeeLastNameInput"
                            width="100%"
                            placeholder="Enter last name"
                            maxLength="50"
                        />
                    </VBox>
                </HBox>

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                    class="sapUiSmallMarginTop"
                >
                    <VBox width="48%">
                        <Label
                            text="Email"
                            labelFor="employeeEmailInput"
                        />
                        <Input
                            id="employeeEmailInput"
                            width="100%"
                            type="Email"
                            placeholder="Enter email"
                            maxLength="150"
                        />
                    </VBox>

                    <VBox width="48%">
                        <Label
                            text="Phone"
                            labelFor="employeePhoneInput"
                        />
                        <Input
                            id="employeePhoneInput"
                            width="100%"
                            type="Tel"
                            placeholder="Enter phone number"
                            maxLength="20"
                        />
                    </VBox>
                </HBox>

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                    class="sapUiSmallMarginTop"
                >
                    <VBox width="48%">
                        <Label
                            text="Designation"
                            labelFor="employeeDesignationInput"
                        />
                        <Input
                            id="employeeDesignationInput"
                            width="100%"
                            placeholder="Enter designation"
                            maxLength="100"
                        />
                    </VBox>

                    <VBox width="48%">
                        <Label
                            text="Joining Date"
                            labelFor="employeeJoiningDatePicker"
                        />
                        <DatePicker
                            id="employeeJoiningDatePicker"
                            width="100%"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd MMM yyyy"
                            placeholder="Select joining date"
                        />
                    </VBox>
                </HBox>

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                    class="sapUiSmallMarginTop"
                >
                    <VBox width="48%">
                        <Label
                            text="Department"
                            labelFor="employeeDepartmentSelect"
                        />
                        <Select
                            id="employeeDepartmentSelect"
                            width="100%"
                            selectedKey=""
                        >
                            <items>
                                <core:Item
                                    key=""
                                    text="Select Department"
                                />
                                <core:Item
                                    key="1"
                                    text="HR"
                                />
                                <core:Item
                                    key="2"
                                    text="IT"
                                />
                                <core:Item
                                    key="3"
                                    text="Finance"
                                />
                                <core:Item
                                    key="4"
                                    text="Sales"
                                />
                                <core:Item
                                    key="5"
                                    text="Marketing"
                                />
                                <core:Item
                                    key="6"
                                    text="Operations"
                                />
                                <core:Item
                                    key="7"
                                    text="Customer Support"
                                />
                                <core:Item
                                    key="8"
                                    text="R&D"
                                />
                                <core:Item
                                    key="9"
                                    text="Legal and Compliance"
                                />
                                <core:Item
                                    key="10"
                                    text="Administration"
                                />
                            </items>
                        </Select>
                    </VBox>

                    <VBox width="48%">
                        <Label
                            text="Manager Name"
                            labelFor="employeeManagerNameInput"
                        />
                        <Input
                            id="employeeManagerNameInput"
                            width="100%"
                            placeholder="Enter manager name"
                            maxLength="100"
                        />
                    </VBox>
                </HBox>
            </VBox>
        </content>

        <beginButton>
            <Button
                id="employeeDialogSaveButton"
                text="Save"
                type="Emphasized"
                icon="sap-icon://save"
                press=".onSaveEmployee"
            />
        </beginButton>

        <endButton>
            <Button
                id="employeeDialogCancelButton"
                text="Cancel"
                press=".onCancelEmployee"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>